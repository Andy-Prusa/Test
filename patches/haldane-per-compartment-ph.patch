+        #
+        # pH and SO2 are COUPLED and are solved together. The saturation term
+        # in ph_from_pco2_be is the acid-base limb of the Haldane effect -- as
+        # haemoglobin desaturates it becomes a weaker acid, so at fixed base
+        # excess the blood holds more CO2 at any given PCO2. This used to pass
+        # so2=0.99 as a fixed argument while handing the TRUE saturation to
+        # co2_content below, which suppressed that limb exactly when the
+        # patient desaturated, and ph_from_pco2_be's own docstring says
+        # under-representing it "translates directly into an overestimate of
+        # the rate of rise of PaCO2". Invisible to every patent-airway
+        # benchmark, where SaO2 never leaves 0.99. Three passes from 0.99
+        # converge to better than 3e-6 in pH; `pco2_from_co2_content` does the
+        # same fixed point internally for the inverse.
+        pc_clamped = np.clip(p_co2_c, 5.0, 250.0)
+        sc_o2_c = np.full(pt.n_vq, 0.99)
+        for _ in range(3):
+            ph_c = np.array([bg.ph_from_pco2_be(float(pc), be, hb,
+                                                so2=float(so), temp=temp)
+                             for pc, so in zip(pc_clamped, sc_o2_c)])
+            sc_o2_c = bg.so2_from_po2(p_o2_c, ph_c, p_co2_c, temp)
         cc_o2_c = bg.HUFNER * hb * sc_o2_c + bg.O2_SOL * p_o2_c
         cc_co2_c = bg.co2_content(p_co2_c, ph_c, sc_o2_c, hb, temp)
 
