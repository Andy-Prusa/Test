#!/bin/sh
#
# pre-commit — the model's benchmarks gate every commit.
#
# HANDOVER.md: "Several changes during development silently broke earlier
# agreements and were only caught by re-running things by hand." This hook is
# what stops that being possible again. A commit that breaks a benchmark does
# not happen.
#
# Runs, in order, cheapest first:
#   build_page.py --check   airway_scenario.html still matches model.js
#   build_site.py --check   site/ still matches airway_scenario.html
#   check_sources.py --check README.md's read-status table matches the registry
#   test_parity.py          apnoea_core.py vs model.js on identical inputs, 1%
#   test_validation.py      every clinical and model benchmark
#
# Both are run against the WORKING TREE, not the staged index. If you have
# unstaged edits to a model file the hook says so, because what it just
# validated is then not exactly what you are committing.
#
# Escape hatches, in order of preference:
#   git commit --no-verify        skip the hook for one commit
#   SKIP_MODEL_TESTS=1 git commit same, and more obvious in the shell history
#
# Enable in a fresh clone (git does not clone hooks):
#   ./setup-hooks.sh              or: git config core.hooksPath .githooks

set -u

if [ "${SKIP_MODEL_TESTS:-0}" != "0" ]; then
    echo "pre-commit: SKIP_MODEL_TESTS set, skipping the model benchmarks."
    exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found, so the benchmarks cannot run."
    echo "            Install it, or commit with --no-verify and say so in"
    echo "            the commit message."
    exit 1
fi

# Distinguish "the model is broken" from "this machine cannot run the model".
# Without this the suites die on an ImportError and the hook reports a failed
# benchmark, which sends whoever hit it looking for a bug in the physics.
missing=$(python3 - <<'PY' 2>/dev/null
import importlib.util
print(" ".join(m for m in ("numpy", "scipy")
                if importlib.util.find_spec(m) is None))
PY
)
if [ -n "${missing:-}" ]; then
    echo "pre-commit: the benchmarks cannot run on this machine -- missing:"
    echo "              $missing"
    echo "            This is an environment problem, not a model failure."
    echo "            Install with:  pip install -r requirements.txt"
    exit 1
fi

if ! command -v node >/dev/null 2>&1; then
    echo "pre-commit: node not found, so model.js cannot be run and the port"
    echo "            cannot be checked against the Python. Install node, or"
    echo "            commit with --no-verify and say in the message that"
    echo "            parity is unverified."
    exit 1
fi

# Warn when the tree under test is not the tree being committed.
unstaged=$(git diff --name-only -- '*.py' '*.js' 2>/dev/null)
if [ -n "$unstaged" ]; then
    echo "pre-commit: NOTE - these tracked model files have unstaged edits, so"
    echo "            the hook is testing something other than what you are"
    echo "            about to commit:"
    echo "$unstaged" | sed 's/^/              /'
fi

start=$(date +%s)
status=0

run_suite() {
    name=$1
    file=$2
    shift 2
    if [ ! -f "$file" ]; then
        echo "pre-commit: $file is missing, cannot run $name."
        return 1
    fi
    echo "pre-commit: $name ($file) ..."
    if python3 "$file" "$@"; then
        return 0
    fi
    echo "pre-commit: $name FAILED."
    return 1
}

# How many processes the validation suite may use. It is fifteen independent
# test functions sharing nothing but a read-only KNOWN_OPEN, so running them
# in a pool is a scheduling change and not a numerical one -- and that is
# PROVEN rather than assumed: on 2026-09-29 a parallel run and a sequential
# run of the whole suite were diffed and are byte-identical, 616s against
# 2064s on four cores. See the -j block in test_validation.py.
jobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)

# Cheapest first, so a trivial mistake is reported in a second rather than
# after four minutes of numerical integration.
#
# The page staleness check comes first because it is the easiest thing to
# forget: airway_scenario.html embeds its own copy of model.js, so editing the
# model without rebuilding leaves the page running different physics from the
# file beside it, and nothing else in the repo would notice.
# sweeps.json is the SAME CLASS OF ARTIFACT as the embedded model and site/:
# generated, committed, and silently wrong if the engine moves without it.
# It is checked FIRST because it is the cheapest of the three and because
# build_page.py now refuses to build without it -- a missing sweeps.json would
# otherwise surface as a confusing page-freshness failure.
if [ -f build_sweeps.js ] && command -v node >/dev/null 2>&1; then
    echo "pre-commit: sweep freshness (build_sweeps.js --check) ..."
    node build_sweeps.js --check || status=1
fi

if [ -f build_page.py ]; then
    echo "pre-commit: page freshness (build_page.py --check) ..."
    python3 build_page.py --check || status=1
    # site/ is the DEPLOYED copy of the page. A copy rots the moment the
    # page is rebuilt and the copy is not, and the rot is invisible: the
    # tests pass against a page nobody is serving. Cheap file compare.
    echo "pre-commit: deploy folder (build_site.py --check) ..."
    python3 build_site.py --check || status=1
fi

# Same class of check, same reason, added 2026-09-25. README.md's table of
# WHICH PAPERS HAVE BEEN READ is generated from sources_registry.py. It is
# here rather than left to a human because on 2026-09-25 that table was found
# wrong on four of its eight rows, telling a sponsor that six of eight sources
# were unread when six of eight HAD been read. It is an invariant BETWEEN
# DOCUMENTS, which is what this hook is for -- unlike handover_numbers.py,
# which checks claims about the world and is deliberately kept out.
if [ -f check_sources.py ]; then
    echo "pre-commit: source-status table (check_sources.py --check) ..."
    python3 check_sources.py --check || status=1
fi

if [ "$status" -eq 0 ]; then
    run_suite "cross-language parity" test_parity.py || status=1
fi

if [ "$status" -eq 0 ]; then
    run_suite "validation benchmarks" test_validation.py -j"$jobs" || status=1
fi

elapsed=$(( $(date +%s) - start ))

if [ "$status" -ne 0 ]; then
    echo
    echo "=============================================================="
    echo " COMMIT BLOCKED after ${elapsed}s — a model benchmark failed."
    echo
    echo " Fix it, or if you are deliberately committing a known-broken"
    echo " intermediate state:"
    echo "     git commit --no-verify"
    echo " and say in the commit message which benchmark is broken and"
    echo " why, so the next person does not have to work it out."
    echo "=============================================================="
    exit 1
fi

echo "pre-commit: all benchmarks passed in ${elapsed}s."
exit 0
